#!/usr/bin/env fish
# Keep Waybar checks beside the other application status lines.
{{ if and (eq .chezmoi.os "linux") .isClient -}}

{{ include ".chezmoihelpers/status.fish" }}
{{ include ".chezmoitemplates/fish_logging.fish" }}
setup_logging linux-build-waybar-lua

# Waybar 0.16.0 is the first expected release to include the Hyprland Lua IPC
# workspace-dispatch fix. Keep the custom build until the numeric workspace
# sorting patch is upstream too; a version threshold alone is insufficient.
set waybar_release_threshold 0.16.0
set waybar_source_dir "$HOME/.local/share/chezetc/waybar"
set waybar_build_root "$HOME/.cache/chezetc/waybar"
set waybar_patch_file (mktemp /tmp/chezetc-waybar-patch.XXXXXX)
# Embed the managed patch so both repositories can be updated independently.
printf '%s\n' '{{ include ".chezmoitemplates/patches/waybar-numeric-workspace-sort.patch" }}' > "$waybar_patch_file"
function cleanup_waybar_patch --on-event fish_exit
    command rm -f -- "$waybar_patch_file"
end
set waybar_prefix "$HOME/.local/lib/chezetc/waybar"
set waybar_binary "$waybar_prefix/bin/waybar"
set waybar_revision_file "$waybar_prefix/revision"
set waybar_launcher "$HOME/.local/bin/waybar"
set waybar_failure_log "/tmp/chezetc-waybar-build-failure.log"

function write_waybar_launcher
    mkdir -p (dirname "$waybar_launcher")
    or return 1

    set launcher_tmp (mktemp)
    or return 1

    printf '%s\n' \
        '#!/usr/bin/env sh' \
        'set -eu' \
        'local_binary="$HOME/.local/lib/chezetc/waybar/bin/waybar"' \
        'if [ -x "$local_binary" ]; then' \
        '    exec "$local_binary" "$@"' \
        'fi' \
        'exec /usr/bin/waybar "$@"' > "$launcher_tmp"
    chmod 755 "$launcher_tmp"
    and mv "$launcher_tmp" "$waybar_launcher"
end

function stable_version
    string match -r '[0-9]+(\.[0-9]+){1,2}' -- $argv[1] | head -n 1
end

function version_at_least
    set installed (string split . -- (stable_version $argv[1]))
    set required (string split . -- (stable_version $argv[2]))

    for index in 1 2 3
        set installed_part 0
        set required_part 0
        if test $index -le (count $installed)
            set installed_part $installed[$index]
        end
        if test $index -le (count $required)
            set required_part $required[$index]
        end

        if test $installed_part -gt $required_part
            return 0
        else if test $installed_part -lt $required_part
            return 1
        end
    end

    return 0
end

function available_waybar_version
    dnf repoquery --latest-limit 1 --qf '%{version}\n' waybar 2>/dev/null | head -n 1
end

function ensure_waybar_source
    mkdir -p (dirname "$waybar_source_dir")
    or return 1

    if not test -d "$waybar_source_dir/.git"
        step_run "Waybar source" git clone https://github.com/Alexays/Waybar.git "$waybar_source_dir"
        return $status
    end

    set shallow_repository (git -C "$waybar_source_dir" rev-parse --is-shallow-repository 2>/dev/null)
    if test "$shallow_repository" = true
        set fetch_args --unshallow
    else
        set fetch_args
    end

    if not git -C "$waybar_source_dir" fetch --quiet $fetch_args origin master
        step_skip_ok "Waybar source" "offline; keeping local checkout"
        return 0
    end

    set merge_error (git -C "$waybar_source_dir" merge --ff-only --quiet origin/master 2>&1)
    if test $status -eq 0
        step_skip_ok "Waybar source" "no changes"
    else
        step_error "Waybar source" (string trim -- "$merge_error")
        return 1
    end
end

function build_waybar
    set source_revision (git -C "$waybar_source_dir" rev-parse HEAD)
    or return 1
    set patch_revision (sha256sum "$waybar_patch_file" | string split -f1 " ")
    or return 1
    set build_revision "$source_revision:$patch_revision"
    set waybar_build_source "$waybar_build_root/$source_revision-$patch_revision"
    set waybar_build_dir "$waybar_build_source/build"
    set built_revision
    if test -f "$waybar_revision_file"
        set built_revision (string trim < "$waybar_revision_file")
    end

    if test -x "$waybar_binary"; and test "$build_revision" = "$built_revision"
        step_skip_ok "Waybar Lua build" "no changes"
        return 0
    end

    # A separate checkout keeps the upstream fetch/merge tree unpatched.
    if not test -d "$waybar_build_source"
        mkdir -p "$waybar_build_root"
        or return 1
        git -C "$waybar_source_dir" worktree add --detach "$waybar_build_source" "$source_revision"
        or return 1
    end
    if git -C "$waybar_build_source" apply --check "$waybar_patch_file"
        git -C "$waybar_build_source" apply "$waybar_patch_file"
        or return 1
    else if not git -C "$waybar_build_source" apply --reverse --check "$waybar_patch_file"
        step_error "Waybar workspace patch" "upstream changed; keeping installed binary"
        return 1
    end

    set meson_options \
        "--prefix=$waybar_prefix" \
        -Dman-pages=disabled \
        -Dtests=disabled \
        -Dsystemd=disabled \
        -Dlibinput=disabled \
        -Dlibnl=enabled \
        -Dlibudev=enabled \
        -Dlibevdev=disabled \
        -Dupower_glib=disabled \
        -Dpipewire=disabled \
        -Dmpris=disabled \
        -Dmpd=disabled \
        -Drfkill=disabled \
        -Djack=disabled \
        -Dwireplumber=disabled \
        -Dgps=disabled \
        -Dwwan=disabled \
        -Dcava=disabled

    step_run_silent_logged "Configure Waybar Lua build" "$waybar_failure_log" meson setup "$waybar_build_dir" "$waybar_build_source" $meson_options
    or return 1
    # Waybar's generated protocol headers are not fully ordered on master;
    # parallel Ninja jobs can compile a consumer before its header exists.
    step_run_silent_logged "Compile Waybar Lua build" "$waybar_failure_log" ninja -C "$waybar_build_dir" -j1
    or return 1
    step_run_silent_logged "Install Waybar Lua build" "$waybar_failure_log" meson install -C "$waybar_build_dir"
    or return 1

    mkdir -p "$waybar_prefix"
    and printf '%s\n' "$build_revision" > "$waybar_revision_file"
end

set available_release (available_waybar_version)
if test -n "$available_release"; and version_at_least "$available_release" "$waybar_release_threshold"
    step_note "Fedora offers Waybar $available_release; keep this custom build until the numeric workspace-sort patch is also upstream."
end

ensure_waybar_source
or exit 1
build_waybar
or begin
    # A build failure must not replace the working binary or launcher.
    if test -f "$waybar_failure_log"
        step_log_created "$waybar_failure_log"
    end
    step_warn "Waybar build unavailable; keeping the existing launcher and binary"
    exit 0
end

write_waybar_launcher
or begin
    step_fail "Write Waybar launcher"
    exit 1
end

{{ end -}}
