#!/usr/bin/env fish
{{ if and (eq .chezmoi.os "linux") .isClient -}}
{{ include ".chezmoihelpers/desktop-user.fish" }}
{{ include ".chezmoihelpers/status.fish" }}
{{ include ".chezmoitemplates/fish_logging.fish" }}
setup_logging linux-install-hyprvoice

function install_hyprvoice
    set -l installer (mktemp); or return 1
    printf '%s' {{ include ".chezmoitemplates/update-client-cli-releases.py" | b64enc | quote }} | base64 --decode > "$installer"
    or return $status
    python3 "$installer" hyprvoice
    set -l result $status
    rm -f "$installer"
    return $result
end

step_run_quiet "Hyprvoice" install_hyprvoice
or exit $status
{{ end -}}
