#!/usr/bin/env fish
{{ if and (eq .chezmoi.os "linux") .isServer -}}
# GDM 50 greeters use transient user records, including shadow entries.
set fedora_release (rpm -E %fedora)
if string match -qr '^[0-9]+$' -- "$fedora_release"; and test "$fedora_release" -ge 44
    {{ include ".chezmoihelpers/status.fish" }}
    step_run_note_as CHECK "Systemd shadow lookups" configured sudo python3 /etc/si-provision/nss_systemd.py --apply
    or exit 1
end
{{ end -}}
