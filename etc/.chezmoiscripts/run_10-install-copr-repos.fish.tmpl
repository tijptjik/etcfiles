#!/usr/bin/env fish
if test "$FLEET_DEFER_SYSTEM_HOOKS" = 1
    exit 0
end
# Run on every apply so this section stays in the ordered tjikup report.
{{ if eq .chezmoi.os "linux" -}}

set -x SUDO_ASKPASS ""           # force sudo to ask on the terminal

# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

{{ include ".chezmoihelpers/status.fish" }}
{{ include ".chezmoitemplates/fish_logging.fish" }}
setup_logging linux-install-copr

# Check if a COPR repository is already configured. `dnf copr list` includes
# configured repositories, including ones that may have been disabled later.
function is_copr_configured
    set copr_repo $argv[1]
    # dnf copr list returns repos in format: copr.fedorainfracloud.org/user/repo
    # Convert our format (user/repo) to match
    set full_repo "copr.fedorainfracloud.org/$copr_repo"
    dnf copr list 2>/dev/null | grep -q "^$full_repo\$"
end

function copr_fallback_chroot
    set copr_repo $argv[1]
    set current_fedora (rpm -E %fedora)
    set arch (uname -m)
    set repo_parts (string split / -- "$copr_repo")

    if test (count $repo_parts) -ne 2
        return 1
    end

    set owner $repo_parts[1]
    set project $repo_parts[2]

    curl -fsSL "https://copr.fedorainfracloud.org/api_3/project?ownername=$owner&projectname=$project" \
        | jq -r --arg arch "$arch" --argjson current "$current_fedora" '
            .chroot_repos
            | keys[]
            | capture("^fedora-(?<version>[0-9]+)-(?<arch>.+)$") as $chroot
            | select($chroot.arch == $arch)
            | select(($chroot.version | tonumber) <= $current)
            | [$chroot.version | tonumber, "fedora-\($chroot.version)-\($chroot.arch)"]
            | @tsv
        ' \
        | sort -nr \
        | head -n 1 \
        | cut -f2
end

# Enable COPR repository
function enable_copr
    set copr_repo $argv[1]
    if is_copr_configured $copr_repo
        step_skip_ok "$copr_repo" available
        return 0
    end

    # Select a supported chroot before emitting an INSTALL result. A successful
    # compatibility fallback must not leave a false FAILED event in the report.
    set selected_chroot (copr_fallback_chroot $copr_repo)
    if test -z "$selected_chroot"
        status_msg FAILED "✗" "$copr_repo" "no supported chroot or metadata unavailable"
        return 1
    end
    set -l result_note enabled
    set current_chroot "fedora-"(rpm -E %fedora)"-"(uname -m)
    if test "$selected_chroot" != "$current_chroot"
        set result_note "using $selected_chroot"
    end
    step_run_note_quiet "$copr_repo" "$result_note" sudo dnf copr enable -y $copr_repo $selected_chroot
    or return 1
end

# Migrate si away from the desktop COPR formerly enabled for every host.
# Keep the definition for troubleshooting; clients still enable it below.
{{ if .isServer -}}
set hyprland_repo 'copr:copr.fedorainfracloud.org:lionheartp:Hyprland'
if dnf repo list --enabled --quiet | string match -q "$hyprland_repo *"
    step_run_note_as DISABLE "Hyprland COPR" "client-only" sudo dnf config-manager setopt "$hyprland_repo.enabled=0"
    or exit 1
end
{{ end }}

# Initialize package arrays
set common_copr_repos
set client_copr_repos

# Add common COPR repositories
{{ range .packages.common.copr -}}
set -a common_copr_repos '{{ . }}'
{{ end }}

# Add client-specific COPR repositories
{{ if .isClient -}}
{{ range .packages.client.copr -}}
set -a client_copr_repos '{{ . }}'
{{ end }}
{{ end }}

# Enable common COPR repositories
if test (count $common_copr_repos) -gt 0
    step_header "Common COPR"

    # Enable each COPR repository
    for repo in $common_copr_repos
        enable_copr $repo
        or exit 1
    end
end

# Enable client-specific COPR repositories
{{ if .isClient -}}
if test (count $client_copr_repos) -gt 0
    step_header "Client COPR"

    # Enable each COPR repository
    for repo in $client_copr_repos
        enable_copr $repo
        or exit 1
    end
end
{{ end }}

{{ end }}
