#!/usr/bin/env fish
{{ if eq .chezmoi.os "linux" -}}

{{ include ".chezmoihelpers/status.fish" }}
{{ include ".chezmoitemplates/fish_logging.fish" }}
setup_logging linux-enable-tailscale

step_header "Tailscale"

if not command -q tailscale
    step_warn "Tailscale package is unavailable"
    exit 0
end

if systemctl is-enabled --quiet tailscaled; and systemctl is-active --quiet tailscaled
    step_skip_ok "Tailscale daemon" enabled
else
    step_run_note "Tailscale daemon" enabled sudo systemctl enable --now tailscaled
    or exit 1
end

# Permit the interactive user and user services (including Collie) to manage
# Serve without giving them general sudo access.  A Chezetc system apply may
# itself run under sudo, so preserve the account that invoked sudo rather than
# assigning this role to root.
set -l tailscale_operator "$SUDO_USER"
if test -z "$tailscale_operator"
    set tailscale_operator (id -un)
end
set -l configured_tailscale_operator (sudo tailscale debug prefs 2>/dev/null | jq -r '.OperatorUser // empty' 2>/dev/null)
if test "$configured_tailscale_operator" = "$tailscale_operator"
    step_skip_ok "Tailscale operator for $tailscale_operator" configured
else
    step_run_note "Tailscale operator for $tailscale_operator" configured sudo tailscale set --operator=$tailscale_operator
    or exit 1
end

set -l tailscale_state (tailscale status --json 2>/dev/null | jq -r '.BackendState // empty' 2>/dev/null)
if test "$tailscale_state" = Running
    step_skip_ok "Tailscale tailnet login" connected
else if test "$tailscale_state" = NeedsLogin
    step_warn_note "Tailscale login required," "run tailscale up"
else if test -n "$tailscale_state"
    # Stopped is expected on desktops while unlocked; it does not mean the
    # device has lost its tailnet enrollment.
    step_skip_ok "Tailscale tailnet login" "$tailscale_state"
else
    step_warn "Tailscale status unavailable"
end

{{ if .isDesktop -}}
# fi is reachable from the tailnet only while its Hyprlock wrapper is active.
# Keep the daemon enabled for boot reliability, but leave the node disconnected
# after an ordinary desktop apply.
if not pgrep -x hyprlock >/dev/null 2>&1
    tailscale down >/dev/null 2>&1
    and step_skip_ok "Desktop tailnet connectivity" "off until lock"
end
{{ end -}}
{{ end -}}
